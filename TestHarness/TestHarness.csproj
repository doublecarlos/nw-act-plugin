<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- Keep LangVersion in sync with what ACT uses to compile the plugin.
         This ensures Neverwinter.cs stays compatible. Raise only if ACT does. -->
    <LangVersion>5</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Neverwinter.cs declares its own [assembly: AssemblyTitle/Version] -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Neverwinter.cs uses System.Windows.Forms -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- Include the plugin source directly so tests compile against the real code -->
  <ItemGroup>
    <Compile Include="../Neverwinter.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
  </ItemGroup>

</Project>
